<Window x:Class="DQOPR.NetPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DQOPR NetPulse"
        Width="1260"
        Height="820"
        MinWidth="1040"
        MinHeight="700">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding StartCommand}" />
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding QuickTestCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCurrentSessionCommand}" />
        <KeyBinding Key="F1" Command="{Binding OpenDocumentationCommand}" />
    </Window.InputBindings>

    <DockPanel Background="#F7F8FA">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New monitoring session" InputGestureText="Ctrl+N" Command="{Binding StartCommand}" />
                <MenuItem Header="Run _Quick Test" InputGestureText="Ctrl+Q" Command="{Binding QuickTestCommand}" />
                <MenuItem Header="_Open session" Command="{Binding ShowHistoryCommand}" />
                <MenuItem Header="_Export current session" InputGestureText="Ctrl+E" Command="{Binding ExportCurrentSessionCommand}" />
                <Separator />
                <MenuItem Header="_Settings" Command="{Binding ShowSettingsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Monitor">
                <MenuItem Header="_Start" Command="{Binding StartCommand}" />
                <MenuItem Header="_Pause" Command="{Binding PauseCommand}" />
                <MenuItem Header="_Resume" Command="{Binding ResumeCommand}" />
                <MenuItem Header="S_top" Command="{Binding StopCommand}" />
                <Separator />
                <MenuItem Header="Internet Feels _Bad Now" Command="{Binding MarkerCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Dashboard" Command="{Binding ShowDashboardCommand}" />
                <MenuItem Header="_History" Command="{Binding ShowHistoryCommand}" />
                <MenuItem Header="_Reports" Command="{Binding ShowReportsCommand}" />
                <MenuItem Header="_Activity log" Command="{Binding ShowActivityLogCommand}" />
                <Separator />
                <MenuItem Header="_Refresh" InputGestureText="Ctrl+R" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Documentation" InputGestureText="F1" Command="{Binding OpenDocumentationCommand}" />
                <MenuItem Header="Open _data folder" Command="{Binding OpenDataFolderCommand}" />
                <MenuItem Header="Open _logs folder" Command="{Binding OpenLogsFolderCommand}" />
                <MenuItem Header="_Report an issue" Command="{Binding ReportIssueCommand}" />
                <Separator />
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" BorderBrush="#D7DCE2" BorderThickness="0,1,0,0" Padding="8,4" Background="#FFFFFF">
            <TextBlock FontSize="12" Text="{Binding Feedback, TargetNullValue=Ready}" />
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="0">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="24" FontWeight="SemiBold" Text="DQOPR NetPulse" />
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ElapsedActiveTime, StringFormat=Elapsed: {0}}" />
                                    <TextBlock Margin="20,0,0,0" Text="{Binding RemainingTime, StringFormat=Remaining: {0}}" />
                                    <TextBlock Margin="20,0,0,0" Text="{Binding LastMeasurementAge, StringFormat=Last measurement: {0}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock AutomationProperties.AutomationId="StatusText" FontSize="18" FontWeight="SemiBold" Text="{Binding Status}" TextAlignment="Right" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding CurrentOperation}" TextAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="1" Margin="0,20,0,0" Columns="4" Rows="3">
                            <GroupBox Header="Router latency" Margin="0,0,12,12"
                                      ToolTip="Median ICMP round-trip time to the detected default gateway for the current probe stream.">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding RouterLatency}" />
                            </GroupBox>
                            <GroupBox Header="Internet latency" Margin="0,0,12,12"
                                      ToolTip="Median ICMP round-trip time to the selected internet target. DNS, TCP, and HTTPS timings are not included.">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding InternetLatency}" TextWrapping="Wrap" TextAlignment="Center" />
                            </GroupBox>
                            <GroupBox Header="Internet jitter" Margin="0,0,12,12"
                                      ToolTip="Mean absolute difference between consecutive successful ICMP RTT samples from the same session, target, address family, and probe stream. Requires at least 3 successful samples.">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding InternetJitter}" TextWrapping="Wrap" TextAlignment="Center" />
                            </GroupBox>
                            <GroupBox Header="ICMP packet loss" Margin="0,0,0,12"
                                      ToolTip="Packet-loss percentage for the same internet ICMP target shown in the latency card. DNS, TCP, HTTPS, and throughput failures are separate.">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding PacketLoss}" TextWrapping="Wrap" TextAlignment="Center" />
                            </GroupBox>
                            <GroupBox Header="Current interface" Margin="0,0,12,12">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding CurrentInterface}" TextWrapping="Wrap" />
                            </GroupBox>
                            <GroupBox Header="Default gateway" Margin="0,0,12,12">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding DefaultGateway}" TextWrapping="Wrap" />
                            </GroupBox>
                            <GroupBox Header="DNS" Margin="0,0,12,12">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding DnsHealth}" />
                            </GroupBox>
                            <GroupBox Header="TCP / HTTPS" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding TcpHealth, StringFormat=TCP: {0}}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding HttpsHealth, StringFormat=HTTPS: {0}}" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Connection to router" Margin="0,0,12,0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding RouterHealth}" />
                            </GroupBox>
                            <GroupBox Header="Download estimate" Margin="0,0,12,0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding LatestDownload}" />
                            </GroupBox>
                            <GroupBox Header="Upload estimate" Margin="0,0,12,0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding LatestUpload}" />
                            </GroupBox>
                            <GroupBox Header="Monitoring state">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding Status}" />
                            </GroupBox>
                        </UniformGrid>

                        <Button Grid.Row="2"
                                AutomationProperties.AutomationId="RunQuickTestButton"
                                Margin="0,8,0,0"
                                Height="44"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Command="{Binding QuickTestCommand}"
                                Content="Run Quick Test" />

                        <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal">
                            <Button AutomationProperties.AutomationId="StartMonitoringButton" Width="150" Height="34" Margin="0,0,10,0" Command="{Binding StartCommand}" Content="Start Monitoring" />
                            <Button AutomationProperties.AutomationId="PauseButton" Width="100" Height="34" Margin="0,0,10,0" Command="{Binding PauseCommand}" Content="Pause" />
                            <Button AutomationProperties.AutomationId="ResumeButton" Width="100" Height="34" Margin="0,0,10,0" Command="{Binding ResumeCommand}" Content="Resume" />
                            <Button AutomationProperties.AutomationId="StopButton" Width="100" Height="34" Margin="0,0,10,0" Command="{Binding StopCommand}" Content="Stop" />
                            <Button Width="190" Height="34" Command="{Binding MarkerCommand}" Content="Internet Feels Bad Now" />
                        </StackPanel>

                        <GroupBox Grid.Row="4" Margin="0,20,0,0" Header="Recent activity">
                            <ListBox AutomationProperties.AutomationId="RecentActivityList" MinHeight="160" BorderThickness="0" ItemsSource="{Binding RecentActivity}" />
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History">
                <DockPanel Margin="20">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Width="110" Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="Refresh" />
                        <Button Width="150" Margin="0,0,8,0" Command="{Binding OpenSessionCommand}" Content="Open Details" />
                        <Button Width="150" Margin="0,0,8,0" Command="{Binding ExportCurrentSessionCommand}" Content="Export Session" />
                        <Button Width="150" Command="{Binding DeleteSelectedSessionCommand}" Content="Delete Session" />
                    </StackPanel>
                    <DataGrid AutomationProperties.AutomationId="SessionsGrid"
                              ItemsSource="{Binding Sessions}"
                              SelectedItem="{Binding SelectedSession}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open details" Command="{Binding PlacementTarget.DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Export session" Command="{Binding PlacementTarget.DataContext.ExportCurrentSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Delete session" Command="{Binding PlacementTarget.DataContext.DeleteSelectedSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start (local)" Binding="{Binding Start}" Width="165" />
                            <DataGridTextColumn Header="End (local)" Binding="{Binding End}" Width="165" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="95" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                            <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="140" />
                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="120" />
                            <DataGridTextColumn Header="Measurements" Binding="{Binding Measurements}" Width="95" />
                            <DataGridTextColumn Header="Packet loss" Binding="{Binding PacketLoss}" Width="90" />
                            <DataGridTextColumn Header="Average latency" Binding="{Binding AverageLatency}" Width="110" />
                            <DataGridTextColumn Header="Maximum latency" Binding="{Binding MaximumLatency}" Width="115" />
                            <DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="100" />
                            <DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="100" />
                            <DataGridTextColumn Header="Methodology" Binding="{Binding Methodology}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Session Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <GroupBox Header="Session metadata">
                            <StackPanel Margin="8">
                                <TextBlock AutomationProperties.AutomationId="DetailSummaryHeader" FontWeight="SemiBold" Text="{Binding DetailSummaryHeader}" TextWrapping="Wrap" />
                                <TextBlock AutomationProperties.AutomationId="DetailStatusText" Margin="0,8,0,0" Text="{Binding DetailStatus}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="#B91C1C" Text="{Binding DetailErrorSummary}" TextWrapping="Wrap" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Button Width="120" Margin="0,0,8,0" Command="{Binding ShowHistoryCommand}" Content="Back to History" />
                                    <Button Width="110" Margin="0,0,8,0" Command="{Binding PreviousSessionCommand}" Content="Previous" />
                                    <Button Width="110" Margin="0,0,8,0" Command="{Binding NextSessionCommand}" Content="Next" />
                                    <Button Width="110" Margin="0,0,8,0" Command="{Binding RefreshDetailsCommand}" Content="Refresh" />
                                    <Button Width="120" Margin="0,0,8,0" Command="{Binding CopySessionIdCommand}" Content="Copy ID" />
                                    <Button Width="130" Margin="0,0,8,0" Command="{Binding ExportCurrentSessionCommand}" Content="Export Session" />
                                    <Button Width="160" Margin="0,0,8,0" Command="{Binding GenerateHtmlReportCommand}" Content="Generate HTML" />
                                    <Button Width="120" Command="{Binding DeleteSelectedSessionCommand}" Content="Delete" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <GroupBox Header="Latency over time" Margin="0,0,8,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Margin="8,4" Text="{Binding LatencyChartCount, StringFormat=Points: {0}}" />
                                    <Canvas Height="130" Background="#FFFFFF">
                                        <Polyline Points="{Binding LatencyChartPoints}" Stroke="#0B6B6B" StrokeThickness="2" />
                                    </Canvas>
                                </DockPanel>
                            </GroupBox>
                            <GroupBox Header="Jitter over time" Margin="8,0,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Margin="8,4" Text="{Binding JitterChartCount, StringFormat=Points: {0}}" />
                                    <Canvas Height="130" Background="#FFFFFF">
                                        <Polyline Points="{Binding JitterChartPoints}" Stroke="#6246EA" StrokeThickness="2" />
                                    </Canvas>
                                </DockPanel>
                            </GroupBox>
                            <GroupBox Header="Packet loss over time" Margin="0,8,8,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Margin="8,4" Text="{Binding PacketLossChartCount, StringFormat=Points: {0}}" />
                                    <Canvas Height="130" Background="#FFFFFF">
                                        <Polyline Points="{Binding PacketLossChartPoints}" Stroke="#C2410C" StrokeThickness="2" />
                                    </Canvas>
                                </DockPanel>
                            </GroupBox>
                            <GroupBox Header="Download/upload over time" Margin="8,8,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Margin="8,4" Text="{Binding SpeedChartCount, StringFormat=Points: {0}}" />
                                    <Canvas Height="130" Background="#FFFFFF">
                                        <Polyline Points="{Binding SpeedChartPoints}" Stroke="#166534" StrokeThickness="2" />
                                    </Canvas>
                                </DockPanel>
                            </GroupBox>
                        </UniformGrid>

                        <TabControl AutomationProperties.AutomationId="SessionDetailsTabs" Margin="0,12,0,0" SelectedIndex="{Binding SelectedDetailTabIndex}">
                            <TabItem Header="Timeline">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Width="130" Margin="0,0,8,0" Command="{Binding CopyTimelineRowsCommand}" Content="Copy all rows" />
                                        <Button Width="150" Margin="0,0,8,0" Command="{Binding CopyTimelineRowsCommand}" Content="Copy selected rows" />
                                        <Button Width="150" Margin="0,0,8,0" Command="{Binding ExportTimelineCsvCommand}" Content="Export timeline CSV" />
                                        <Button Width="100" Command="{Binding RefreshDetailsCommand}" Content="Refresh" />
                                        <TextBlock Margin="12,5,0,0" Text="{Binding TimelineEmptyMessage}" />
                                    </StackPanel>
                                    <DataGrid AutomationProperties.AutomationId="DetailTimelineGrid" ItemsSource="{Binding DetailTimelineRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" MinHeight="260">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time local" Binding="{Binding TimeLocal}" Width="160" />
                                            <DataGridTextColumn Header="Time UTC" Binding="{Binding TimeUtc}" Width="160" />
                                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="105" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="150" />
                                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140" />
                                            <DataGridTextColumn Header="Address family" Binding="{Binding AddressFamily}" Width="100" />
                                            <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" Width="75" />
                                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="85" />
                                            <DataGridTextColumn Header="Latency ms" Binding="{Binding LatencyMilliseconds}" Width="85" />
                                            <DataGridTextColumn Header="Failure category" Binding="{Binding FailureCategory}" Width="130" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="220" />
                                            <DataGridTextColumn Header="Probe stream ID" Binding="{Binding ProbeStreamId}" Width="260" />
                                            <DataGridTextColumn Header="Methodology version" Binding="{Binding MethodologyVersion}" Width="130" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="ICMP packet loss">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding IcmpEmptyMessage}" />
                                    <DataGrid AutomationProperties.AutomationId="DetailIcmpSummaryGrid" DockPanel.Dock="Top" ItemsSource="{Binding DetailIcmpSummaryRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" MinHeight="150">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="130" />
                                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="130" />
                                            <DataGridTextColumn Header="Family" Binding="{Binding AddressFamily}" Width="80" />
                                            <DataGridTextColumn Header="Probe stream" Binding="{Binding ProbeStreamId}" Width="220" />
                                            <DataGridTextColumn Header="Total" Binding="{Binding TotalProbes}" Width="65" />
                                            <DataGridTextColumn Header="Success" Binding="{Binding SuccessfulProbes}" Width="70" />
                                            <DataGridTextColumn Header="Failed" Binding="{Binding FailedProbes}" Width="70" />
                                            <DataGridTextColumn Header="Loss" Binding="{Binding PacketLossPercent}" Width="70" />
                                            <DataGridTextColumn Header="Min" Binding="{Binding MinimumRtt}" Width="70" />
                                            <DataGridTextColumn Header="Median" Binding="{Binding MedianRtt}" Width="75" />
                                            <DataGridTextColumn Header="Mean" Binding="{Binding MeanRtt}" Width="70" />
                                            <DataGridTextColumn Header="P95" Binding="{Binding P95Rtt}" Width="70" />
                                            <DataGridTextColumn Header="Max" Binding="{Binding MaximumRtt}" Width="70" />
                                            <DataGridTextColumn Header="Jitter" Binding="{Binding Jitter}" Width="110" />
                                            <DataGridTextColumn Header="First sample" Binding="{Binding FirstSampleLocal}" Width="160" />
                                            <DataGridTextColumn Header="Last sample" Binding="{Binding LastSampleLocal}" Width="160" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid AutomationProperties.AutomationId="DetailIcmpRowsGrid" Margin="0,10,0,0" ItemsSource="{Binding DetailIcmpRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" MinHeight="190">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time local" Binding="{Binding TimeLocal}" Width="160" />
                                            <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="130" />
                                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="130" />
                                            <DataGridTextColumn Header="Family" Binding="{Binding AddressFamily}" Width="80" />
                                            <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" Width="75" />
                                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="80" />
                                            <DataGridTextColumn Header="RTT" Binding="{Binding Rtt}" Width="75" />
                                            <DataGridTextColumn Header="Failure" Binding="{Binding Failure}" Width="130" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="180" />
                                            <DataGridTextColumn Header="Probe stream" Binding="{Binding ProbeStreamId}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="DNS / TCP / HTTPS">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding ConnectivityEmptyMessage}" />
                                    <DataGrid AutomationProperties.AutomationId="DetailConnectivityGrid" ItemsSource="{Binding DetailConnectivityRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" MinHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time local" Binding="{Binding TimeLocal}" Width="160" />
                                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="110" />
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="180" />
                                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140" />
                                        <DataGridTextColumn Header="Family" Binding="{Binding AddressFamily}" Width="90" />
                                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90" />
                                        <DataGridTextColumn Header="Response time" Binding="{Binding ResponseTime}" Width="105" />
                                        <DataGridTextColumn Header="Failure" Binding="{Binding FailureCategory}" Width="130" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                        <DataGridTextColumn Header="Methodology" Binding="{Binding MethodologyVersion}" Width="110" />
                                    </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Speed tests">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding SpeedTestsEmptyMessage}" />
                                    <DataGrid AutomationProperties.AutomationId="DetailSpeedTestsGrid" ItemsSource="{Binding DetailSpeedTestRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" MinHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="100" />
                                        <DataGridTextColumn Header="Result status" Binding="{Binding ResultStatus}" Width="180" />
                                        <DataGridTextColumn Header="Mbps" Binding="{Binding MegabitsPerSecond}" Width="85" />
                                        <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="140" />
                                        <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="210" />
                                        <DataGridTextColumn Header="Start local" Binding="{Binding StartLocal}" Width="160" />
                                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" />
                                        <DataGridTextColumn Header="Bytes" Binding="{Binding BytesTransferred}" Width="120" />
                                        <DataGridTextColumn Header="Streams" Binding="{Binding StreamCount}" Width="75" />
                                        <DataGridTextColumn Header="HTTP" Binding="{Binding HttpVersion}" Width="70" />
                                        <DataGridTextColumn Header="Setup" Binding="{Binding SetupDuration}" Width="95" />
                                        <DataGridTextColumn Header="Warm-up" Binding="{Binding WarmupDuration}" Width="95" />
                                        <DataGridTextColumn Header="Failure" Binding="{Binding FailureCategory}" Width="140" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding FailureMessage}" Width="220" />
                                        <DataGridTextColumn Header="Confidence flags" Binding="{Binding ConfidenceFlags}" Width="300" />
                                        <DataGridTextColumn Header="Methodology" Binding="{Binding MethodologyVersion}" Width="150" />
                                    </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Events and markers">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding EventsEmptyMessage}" />
                                    <DataGrid AutomationProperties.AutomationId="DetailEventsGrid" ItemsSource="{Binding DetailEventRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" MinHeight="260">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time local" Binding="{Binding TimeLocal}" Width="160" />
                                            <DataGridTextColumn Header="Event type" Binding="{Binding EventType}" Width="130" />
                                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85" />
                                            <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="150" />
                                            <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="140" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="260" />
                                            <DataGridTextColumn Header="Related target" Binding="{Binding RelatedTarget}" Width="130" />
                                            <DataGridTextColumn Header="Related ID" Binding="{Binding RelatedId}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Reports">
                <StackPanel Margin="20">
                    <GroupBox Header="Selected session">
                        <UniformGrid Columns="3" Margin="8">
                            <TextBlock Text="{Binding SelectedSession.Id, StringFormat=Session: {0}}" />
                            <TextBlock Text="{Binding SelectedSession.Measurements, StringFormat=Measurements: {0}}" />
                            <TextBlock Text="{Binding LastGeneratedFile, StringFormat=Last file: {0}}" />
                        </UniformGrid>
                    </GroupBox>
                    <GroupBox Header="Output location" Margin="0,14,0,0">
                        <DockPanel Margin="8">
                            <Button DockPanel.Dock="Right" Width="120" Margin="8,0,0,0" Command="{Binding OpenExportFolderCommand}" Content="Open Folder" />
                            <TextBox Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </GroupBox>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Width="130" Height="34" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}" Content="Export CSV" />
                        <Button Width="130" Height="34" Margin="0,0,8,0" Command="{Binding ExportJsonCommand}" Content="Export JSON" />
                        <Button Width="170" Height="34" Margin="0,0,8,0" Command="{Binding GenerateHtmlReportCommand}" Content="Generate HTML Report" />
                        <Button Width="140" Height="34" Command="{Binding OpenLastExportCommand}" Content="Open Generated File" />
                    </StackPanel>
                    <GroupBox Header="Report contents" Margin="0,16,0,0">
                        <TextBlock Margin="8" TextWrapping="Wrap"
                                   Text="HTML reports include the session summary, methodology, timing, interface and gateway, latency and jitter statistics, ICMP-only packet loss, DNS/TCP/HTTPS results, speed estimates, user markers, events, charts, and the throughput disclaimer." />
                    </GroupBox>
                    <GroupBox Header="External reference result" Margin="0,16,0,0">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Provider" />
                                    <TextBox Text="{Binding ReferenceProvider, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Download Mbps" />
                                    <TextBox Text="{Binding ReferenceDownload, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Upload Mbps" />
                                    <TextBox Text="{Binding ReferenceUpload, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Latency ms" />
                                    <TextBox Text="{Binding ReferenceLatency, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBox Grid.Row="1" MinHeight="54" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding ReferenceNotes, UpdateSourceTrigger=PropertyChanged}" />
                            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Left" Width="170" Height="32" Command="{Binding SaveReferenceResultCommand}" Content="Save Reference Result" />
                                <TextBlock Margin="12,6,0,0" Text="{Binding ReferenceFeedback}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Grid>
                    </GroupBox>
                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding Feedback}" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,20,12">
                                <TextBlock Text="Monitoring duration" />
                                <TextBox Text="{Binding DraftSettings.MonitoringDuration, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Probe timeout" />
                                <TextBox Text="{Binding DraftSettings.ProbeTimeout, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,12">
                                <TextBlock Text="ICMP interval" />
                                <TextBox Text="{Binding DraftSettings.IcmpInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Speed-test interval" />
                                <TextBox Text="{Binding DraftSettings.SpeedTestInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,12">
                                <TextBlock Text="TCP interval" />
                                <TextBox Text="{Binding DraftSettings.TcpInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="DNS interval" />
                                <TextBox Text="{Binding DraftSettings.DnsInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,12">
                                <TextBlock Text="HTTPS interval" />
                                <TextBox Text="{Binding DraftSettings.HttpsInterval, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="DNS hostname" />
                                <TextBox Text="{Binding DraftSettings.DnsHostname, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="ICMP targets" />
                            <TextBox Margin="0,4,0,10" Text="{Binding DraftSettings.IcmpTargets, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="TCP endpoints" />
                            <TextBox Margin="0,4,0,10" Text="{Binding DraftSettings.TcpEndpoints, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="HTTPS endpoint" />
                            <TextBox Margin="0,4,0,10" Text="{Binding DraftSettings.HttpsEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Download test endpoint" />
                            <TextBox Margin="0,4,0,10" Text="{Binding DraftSettings.DownloadEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Upload test endpoint" />
                            <TextBox Margin="0,4,0,10" Text="{Binding DraftSettings.UploadEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Database path" />
                            <TextBox Margin="0,4,0,10" Text="{Binding DraftSettings.DatabasePath, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Export directory" />
                            <TextBox Margin="0,4,0,10" Text="{Binding DraftSettings.ExportDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Margin="0,4,0,4" IsChecked="{Binding DraftSettings.StartMinimized}" Content="Start minimized" />
                            <CheckBox Margin="0,4,0,4" IsChecked="{Binding DraftSettings.MinimizeToTray}" Content="Minimize to tray" />
                            <CheckBox Margin="0,4,0,10" IsChecked="{Binding DraftSettings.ConfirmBeforeStopping}" Content="Confirm before stopping" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Width="110" Height="34" Margin="0,0,8,0" Command="{Binding SaveSettingsCommand}" Content="Save" />
                            <Button Width="110" Height="34" Margin="0,0,8,0" Command="{Binding CancelSettingsCommand}" Content="Cancel" />
                            <Button Width="140" Height="34" Command="{Binding RestoreDefaultsCommand}" Content="Restore Defaults" />
                            <TextBlock Margin="18,8,0,0" Text="{Binding SettingsValidation}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Activity Log">
                <DockPanel Margin="20">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Width="110" Margin="0,0,8,0" Command="{Binding CopyAllActivityCommand}" Content="Copy" />
                        <Button Width="130" Margin="0,0,8,0" Command="{Binding SaveActivityLogCommand}" Content="Save Log" />
                        <Button Width="110" Command="{Binding ClearActivityCommand}" Content="Clear" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ActivityLog}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="170" />
                            <DataGridTextColumn Header="Event" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="About">
                <StackPanel Margin="20">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="DQOPR NetPulse" />
                    <TextBlock Margin="0,12,0,0" Text="{Binding Version, StringFormat=Version: {0}}" />
                    <TextBlock Margin="0,6,0,0" Text="Publisher: DQOPR" />
                    <TextBlock Margin="0,6,0,0" Text="License: Apache License 2.0" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding RepositoryUrl, StringFormat=Repository: {0}}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding RuntimeInfo, StringFormat=Runtime: {0}}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding AppDataFolder, StringFormat=Database folder: {0}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Width="170" Margin="0,0,8,0" Command="{Binding CopyDiagnosticsCommand}" Content="Copy Diagnostics" />
                        <Button Width="130" Margin="0,0,8,0" Command="{Binding OpenDocumentationCommand}" Content="Documentation" />
                        <Button Width="130" Command="{Binding ReportIssueCommand}" Content="Report Issue" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
