<Window x:Class="DQOPR.NetPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DQOPR NetPulse"
        Width="1180"
        Height="760"
        MinWidth="940"
        MinHeight="620">
    <DockPanel Background="#F7F8FA">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File" />
            <MenuItem Header="_Monitor" />
            <MenuItem Header="_Tools" />
            <MenuItem Header="_Help" />
        </Menu>

        <TabControl DockPanel.Dock="Top" SelectedIndex="0">
            <TabItem Header="Dashboard">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="DQOPR NetPulse" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <TextBlock Text="Elapsed active time: 00:00:00" />
                                <TextBlock Margin="20,0,0,0" Text="Remaining: not started" />
                                <TextBlock Margin="20,0,0,0" Text="Last measurement: none" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Ready" TextAlignment="Right" />
                            <TextBlock Margin="0,8,0,0" Text="Recording: no active session" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1" Margin="0,20,0,0" Columns="3" Rows="2">
                        <GroupBox Header="Latency" Margin="0,0,12,12">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="-- ms" />
                        </GroupBox>
                        <GroupBox Header="Packet Loss" Margin="0,0,12,12">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="-- %" />
                        </GroupBox>
                        <GroupBox Header="Jitter" Margin="0,0,0,12">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Waiting for samples" />
                        </GroupBox>
                        <GroupBox Header="Router Health" Margin="0,0,12,0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Unknown" />
                        </GroupBox>
                        <GroupBox Header="Internet Health" Margin="0,0,12,0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Unknown" />
                        </GroupBox>
                        <GroupBox Header="Current Operation">
                            <TextBlock Margin="10" TextWrapping="Wrap" Text="Waiting to start." />
                        </GroupBox>
                    </UniformGrid>

                    <Button Grid.Row="2"
                            Margin="0,6,0,0"
                            Height="44"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Content="Run Quick Test" />

                    <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal">
                        <Button Width="150" Height="34" Margin="0,0,10,0" Content="Start Monitoring" />
                        <Button Width="100" Height="34" Margin="0,0,10,0" Content="Pause" IsEnabled="False" />
                        <Button Width="100" Height="34" Margin="0,0,10,0" Content="Stop" IsEnabled="False" />
                        <Button Width="190" Height="34" Content="Internet Feels Bad Now" IsEnabled="False" />
                    </StackPanel>

                    <GroupBox Grid.Row="4" Margin="0,20,0,0" Header="Recent activity">
                        <ListBox BorderThickness="0">
                            <ListBoxItem Content="Ready to detect active network adapter." />
                            <ListBoxItem Content="Quick Test will use 10 to 20 latency samples per target." />
                            <ListBoxItem Content="Scheduled speed tests run independently from latency probes." />
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Details" />
            <TabItem Header="Graphs" />
            <TabItem Header="Incidents" />
            <TabItem Header="Reports" />
            <TabItem Header="Sessions" />
            <TabItem Header="Settings" />
            <TabItem Header="Help" />
        </TabControl>
    </DockPanel>
</Window>
